# .env.example — copia como .env y ajusta valores reales
# NUNCA subas el .env real a git (ver .gitignore)
#
# ── Buenas prácticas para AWS (EC2/ECS) más adelante ─────────
# En LOCAL (WSL2), este archivo se lee directo. En EC2/ECS, NO lo
# subas como archivo — usa:
#   - AWS Secrets Manager o SSM Parameter Store para JWT_SECRET,
#     POSTGRES_PASSWORD, AWS_SECRET_ACCESS_KEY
#   - En ECS Task Definition, referencia esos secrets vía
#     "secrets": [{"name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:..."}]
#   - En EC2, usa un IAM Role adjunto a la instancia en vez de
#     AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY — boto3 los toma
#     automáticamente del Instance Metadata Service, sin exponer
#     credenciales en ningún archivo
#   - DATABASE_URL en producción apunta a RDS, no al contenedor
#     `postgres` local — cambia el host, mantén el mismo formato

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=smartpromarco
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=smartpromarco
# Local (Docker):
DATABASE_URL=postgresql+psycopg://smartpromarco:cambia_esta_password@localhost:5432/smartpromarco
# AWS (ejemplo, RDS): postgresql+psycopg://usuario:password@tu-instancia.xxxxx.us-east-1.rds.amazonaws.com:5432/smartpromarco

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# AWS (ejemplo, ElastiCache): redis://tu-cluster.xxxxx.cache.amazonaws.com:6379

# ── Seguridad (genera con: openssl rand -hex 32) ────────────
# En AWS: JWT_SECRET debe venir de Secrets Manager, nunca de un .env commiteado
JWT_SECRET=cambia-esto-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ── AWS Bedrock ───────────────────────────────────────────────
AWS_REGION=us-east-1
# En LOCAL: llena estas dos con credenciales de un usuario IAM de desarrollo
# En EC2/ECS: DÉJALAS VACÍAS — usa un IAM Role en la instancia/task en su lugar
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODEL_ID=anthropic.claude-3-5-sonnet-20241022

# ── Dashboard → API (ajusta si el dashboard corre en otro host) ─
API_BASE_URL=http://localhost:8000
# Docker Compose interno: http://api:8000 (compose.yaml ya lo define así)

# ── QR (ISO/IEC 18004) ──────────────────────────────────────
# En AWS, cambia esto a tu dominio público real, o al Load Balancer
QR_BASE_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# En AWS: ENVIRONMENT=production, DEBUG=false — nunca al revés

# ── Extendido (Fase 3+, ver ADR-001) — no requerido en PoC ──
# MINIO_ROOT_USER=smartpromarco
# MINIO_ROOT_PASSWORD=cambia_esta_password
