{
    "system": "SMARTPROMARCO PoC",
    "module": "matriz_validacion_compras",
    "version": "1.0",
    "rules": [
        {
            "id": "BR-001",
            "name": "Aprobación de Compras y Umbrales (HITL)",
            "description": "Reglas para determinar si una decisión es autónoma o requiere intervención humana.",
            "conditions": {
                "auto_approval": "risk_level == 'LOW' AND amount <= 50000",
                "human_in_the_loop_required": "risk_level == 'HIGH' OR amount > 50000 OR anomaly_detected == true"
            },
            "actions": {
                "on_auto_approval": "generate_approval_uuid",
                "on_human_in_the_loop": "escalate_to_human_reviewer"
            }
        },
        {
            "id": "BR-002",
            "name": "Validación de Auditor Antagonista (LangGraph)",
            "description": "El Agente Auditor debe refutar o validar la decisión del Agente Decisor Protagonista.",
            "conditions": {
                "trigger": "decisor_agent_status == 'PROPOSED'",
                "rejection_criteria": [
                    "falta_evidencia_documental",
                    "incumplimiento_criterios_calidad",
                    "sesgo_detectado_en_decisor"
                ]
            },
            "actions": {
                "on_rejection": "return_to_decisor_with_feedback",
                "on_validation": "proceed_to_final_approval"
            }
        },
        {
            "id": "BR-003",
            "name": "Trazabilidad Documental por QR",
            "description": "Asignación obligatoria de UUID para la trazabilidad de documentos generados.",
            "conditions": {
                "trigger": "document_status == 'FINALIZED'"
            },
            "actions": {
                "execute": [
                    "generate_uuid",
                    "embed_uuid_in_qr_code",
                    "save_to_database"
                ]
            }
        }
    ]
}